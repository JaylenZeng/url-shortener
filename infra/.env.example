# Copy to deploy/.env on the server and fill in real values.
# docker compose reads this automatically. Never commit the real .env.

# Postgres password (used in DATABASE_URL inside docker-compose.prod.yml).
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Auth. Generate a fresh secret for production:  openssl rand -hex 32
# Do NOT reuse the one committed in the repo's .env files.
JWT_SECRET=generate-a-new-one
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
